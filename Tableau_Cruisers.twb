      <aliases enabled='yes' />
      <column datatype='integer' name='[Cabinas_Reservadas]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Cabinas_Totales_Barco]' role='measure' type='quantitative' />
      <column caption='Average Revenue per Booking' datatype='real' name='[Calculation_0432415586115584]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ingreso_Total_Reserva_USD]) / COUNTD([RES_ID])' />
      </column>
      <column caption='Night Stay' datatype='real' name='[Calculation_0432415586521089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Noches_Estancia])' />
      </column>
      <column caption='Revenue per Passenger Night Cruise' datatype='real' name='[Calculation_0432415586676738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Ingreso_Total_Reserva_USD]) / SUM([Noches_Estancia] * [Pasajeros_Reserva])' />
      </column>
